---
import Bi from './Bi.astro';
import { socialLinks } from '../data/social.js';

const year = new Date().getFullYear();

const links = [
  { href: '/tools/business-days/', ja: '営業日計算', en: 'Business days' },
  { href: '/support/', ja: 'サポート / FAQ', en: 'Support / FAQ' },
  { href: '/contact/', ja: 'お問い合わせ', en: 'Contact' },
  { href: '/privacy/', ja: 'プライバシーポリシー', en: 'Privacy Policy' },
  { href: '/tokushoho/', ja: '特定商取引法に基づく表記', en: 'Legal Notice' },
];
---
<footer class="site-footer">
  <div class="wrap footer-stack">
    <div class="row">
      <p class="mono small">© {year} Nokorika Studio</p>
      <div class="links">
        {links.map((item) => (
          <a href={item.href}><Bi ja={item.ja} en={item.en} /></a>
        ))}
      </div>
    </div>
    <div class="social-row">
      <span class="mono small social-label"><Bi ja="発信" en="Follow" /></span>
      <div class="links">
        {socialLinks.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            <Bi ja={`${s.label.ja}（${s.handle.ja}）`} en={`${s.label.en} (${s.handle.en})`} />
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 28px 0;
  }
  .footer-stack {
    display: grid;
    gap: 16px;
  }
  .row,
  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    align-items: center;
    justify-content: space-between;
  }
  .small {
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .social-label {
    flex-shrink: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 24px;
    font-size: 0.85rem;
  }
  .links a {
    position: relative;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.2s ease;
  }
  .links a:hover {
    color: var(--ink);
  }
  .links a:hover::after {
    width: 100%;
  }
</style>
