---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Bi from '../components/Bi.astro';

const items = [
  { ja: '販売事業者', en: 'Seller', ja_v: 'Nokorika Studio', en_v: 'Nokorika Studio' },
  { ja: '運営統括責任者', en: 'Manager', ja_v: '和田　健太郎', en_v: 'Kentaro Wada' },
  {
    ja: '所在地', en: 'Address',
    ja_v: '請求があった場合は遅滞なく開示します',
    en_v: 'Disclosed without delay upon request',
  },
  {
    ja: '電話番号', en: 'Phone number',
    ja_v: '請求があった場合は遅滞なく開示します',
    en_v: 'Disclosed without delay upon request',
  },
  { ja: 'メールアドレス', en: 'Email', ja_v: 'contact@nokorikastudio.com', en_v: 'contact@nokorikastudio.com' },
  {
    ja: '販売価格', en: 'Price',
    ja_v: '「ノコリカ」は無料です（アプリ内課金なし）。「KoeCare」は基本機能を無料で提供し、有料のサブスクリプション等がある場合は各ストア（Google Play / App Store）上の表示価格に従います。',
    en_v: '“Nokorika” is free (no in-app purchases). “KoeCare” offers core features for free; if a paid subscription is available, pricing follows the applicable store listing (Google Play / App Store).',
  },
  {
    ja: '商品代金以外の必要料金', en: 'Additional costs',
    ja_v: 'インターネット接続に必要な通信料はお客様のご負担となります。',
    en_v: 'Internet connection fees are the responsibility of the customer.',
  },
  {
    ja: 'お支払い方法', en: 'Payment methods',
    ja_v: '有料機能がある場合は、各アプリストア（Google Play / App Store 等）が提供する決済方法によります。',
    en_v: 'If paid features are offered, payment methods provided by the applicable app stores (e.g. Google Play / App Store) apply.',
  },
  {
    ja: 'お支払い時期', en: 'Payment timing',
    ja_v: '有料機能を購入する場合は、各アプリストアの決済タイミングに従います。',
    en_v: 'For paid features, payment timing follows the applicable app store’s checkout process.',
  },
  {
    ja: '商品の引渡し時期', en: 'Delivery timing',
    ja_v: 'Google Play または App Store からインストール完了後、直ちにご利用いただけます。',
    en_v: 'Available immediately after installation from Google Play or the App Store.',
  },
  {
    ja: '返品・キャンセルについて', en: 'Returns / cancellations',
    ja_v: '無料で利用できる範囲に返品対象の購入はありません。有料機能の返金・解約は、各アプリストアの規定に従います。',
    en_v: 'There are no purchases subject to return for free features. Refunds and cancellations for paid features follow the applicable app store policies.',
  },
  {
    ja: '動作環境', en: 'System requirements',
    ja_v: 'Android 10.0 以降（Google Play 経由）。ノコリカは iOS 15 以降、KoeCare は iOS 17 以降（いずれも App Store 経由）。',
    en_v: 'Android 10.0 or later (via Google Play). On the App Store: Nokorika supports iOS 15 or later; KoeCare supports iOS 17 or later.',
  },
];
---
<Layout
  title="特定商取引法に基づく表記｜Nokorika Studio"
  titleEn="Legal Notice｜Nokorika Studio"
  description="特定商取引法に基づく表記です。"
  descriptionEn="Legal notice based on the Act on Specified Commercial Transactions."
>
  <Header slot="header" />

  <section class="legal">
    <div class="wrap">
      <p class="eyebrow"><Bi ja="特定商取引法" en="Legal" /></p>
      <h1><Bi ja="特定商取引法に基づく表記" en="Legal Notice" /></h1>
      <p class="lead">
        <Bi
          ja="特定商取引法第11条に基づき、以下のとおり表記します。現在の主な提供内容は、Google Play・App Store で公開しているアプリ「ノコリカ」および「KoeCare」です。"
          en="The following is disclosed in accordance with Article 11 of the Act on Specified Commercial Transactions of Japan. Our current primary offerings are “Nokorika” and “KoeCare” on Google Play and the App Store."
        />
      </p>

      <dl class="legal-table" data-reveal>
        {items.map((item) => (
          <div class="legal-row">
            <dt class="mono"><Bi ja={item.ja} en={item.en} /></dt>
            <dd><Bi ja={item.ja_v} en={item.en_v} /></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Footer slot="footer" />

  <style>
    .legal {
      padding-top: clamp(56px, 9vw, 88px);
    }
    h1 {
      font-size: clamp(1.7rem, 3.2vw, 2.2rem);
      margin: 10px 0 14px;
    }
    .lead {
      color: var(--ink-soft);
      margin-bottom: 36px;
      max-width: 62ch;
    }
    .legal-table {
      margin: 0;
      border-top: 1px solid var(--line);
    }
    .legal-row {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 24px;
      padding: 18px 0;
      border-bottom: 1px solid var(--line);
    }
    .legal-row dt {
      color: var(--ink-soft);
      font-size: 0.85rem;
    }
    .legal-row dd {
      margin: 0;
      line-height: 1.8;
    }
    @media (max-width: 640px) {
      .legal-row {
        grid-template-columns: 1fr;
        gap: 6px;
      }
    }
  </style>
</Layout>
