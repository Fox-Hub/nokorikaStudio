---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Bi from '../../components/Bi.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import { apps } from '../../data/apps.js';
import { koecareReleaseStatus } from '../../data/status.js';

const app = apps.find((a) => a.id === 'koecare') ?? {
  status: { ja: 'Google Play で公開中', en: 'Available on Google Play' },
};

const screenshots = [
  {
    src: '/images/koecare2.png',
    title: { ja: '測定中', en: 'Measuring' },
    caption: {
      ja: 'リアルタイムの dB 表示としきい値アラートで、周囲の音量を把握できます。',
      en: 'Live dB readout and threshold alerts help you grasp ambient volume.',
    },
  },
  {
    src: '/images/koecare3.png',
    title: { ja: '履歴', en: 'History' },
    caption: {
      ja: '日・週・月で音量の推移とアラートを確認できます。',
      en: 'Review volume trends and alerts by day, week, or month.',
    },
  },
  {
    src: '/images/koecare1.png',
    title: { ja: '設定', en: 'Settings' },
    caption: {
      ja: 'しきい値や測定間隔などを調整できます。',
      en: 'Adjust alert thresholds, measurement interval, and more.',
    },
  },
];

const devLog = [
  {
    date: '2026.11.12',
    title: { ja: 'Google Play で公開を開始', en: 'Now available on Google Play' },
    body: {
      ja: '騒音計測アプリ KoeCare を Google Play で公開しました。周囲の音量を数値で確認しながら、しきい値アラートや履歴で日常の騒音を把握できます。',
      en: 'KoeCare is now live on Google Play. Check ambient volume as clear numbers, with threshold alerts and history to understand everyday noise.',
    },
    storeLink: true,
  },
  {
    date: '2026.10.26',
    title: { ja: 'クローズドテストを開始', en: 'Closed testing started' },
    body: {
      ja: 'Google Play でのクローズドテストを開始しました。フィードバックをもとに改善を進め、公開に向けて仕上げていきました。',
      en: 'Closed testing on Google Play started. We used tester feedback to polish the app toward public release.',
    },
  },
];
---
<Layout
  title="KoeCare | 騒音計測アプリ｜Nokorika Studio"
  titleEn="KoeCare | Noise Meter｜Nokorika Studio"
  description="騒音計測アプリ KoeCare の紹介ページです。Google Play で公開中。"
  descriptionEn="KoeCare is a noise meter app by Nokorika Studio, available on Google Play."
>
  <Header slot="header" />

  <section class="hero">
    <div class="wrap hero-copy" data-reveal>
      <span class="date-stamp mono">
        <Bi ja="NOISE METER" en="NOISE METER" />
      </span>
      <h1>
        <span class="i18n" data-lang="ja">身のまわりの音を、<em class="accent-word">わかりやすく</em>測る。</span>
        <span class="i18n" data-lang="en">Measure everyday sound<br />in a way that’s <em class="accent-word">easy to grasp.</em></span>
      </h1>
      <p class="lead">
        <span class="i18n" data-lang="ja">
          <strong>KoeCare</strong>
          は、生活のなかの騒音レベルを計測し、把握しやすくするためのスマートフォン向けアプリです。
        </span>
        <span class="i18n" data-lang="en">
          <strong>KoeCare</strong>
          is a smartphone app for measuring and understanding everyday noise levels.
        </span>
      </p>
      <div class="hero-cta">
        <span class="tag">
          <Bi ja={app.status.ja} en={app.status.en} />
        </span>
        <StoreBadges storeUrl={koecareReleaseStatus.storeUrl} />
      </div>
    </div>
  </section>

  <section id="overview">
    <span class="section-number mono">01</span>
    <div class="wrap">
      <p class="eyebrow"><Bi ja="概要" en="Overview" /></p>
      <h2 data-reveal>
        <Bi ja="騒音を、日常の感覚に近づける。" en="Bringing noise levels closer to everyday sense." />
      </h2>
      <p class="body-text" data-reveal>
        <Bi
          ja="周囲の音量を数値で確認できる騒音計測アプリです。計測のわかりやすさと見やすさに集中し、しきい値アラートや履歴で日常の騒音を把握しやすくしています。"
          en="A noise meter that shows ambient sound levels as clear numbers. It focuses on readable measurement, with threshold alerts and history to help you grasp everyday noise."
        />
      </p>
      <div class="overview-store" data-reveal>
        <StoreBadges storeUrl={koecareReleaseStatus.storeUrl} />
      </div>
    </div>
  </section>

  <section id="screens">
    <span class="section-number mono">02</span>
    <div class="wrap">
      <p class="eyebrow"><Bi ja="画面" en="Screens" /></p>
      <h2 data-reveal>
        <Bi ja="主な画面" en="Key screens" />
      </h2>
      <p class="body-text product-lead" data-reveal>
        <Bi
          ja="測定・履歴・設定の画面イメージです。"
          en="Screens for measuring, history, and settings."
        />
      </p>

      <div class="draft-grid" data-reveal="stagger">
        {screenshots.map((s) => (
          <figure class="draft-card">
            <div class="draft-frame">
              <img src={s.src} alt={s.title.ja} loading="lazy" data-shot-img />
              <div class="draft-placeholder" data-shot-placeholder hidden>
                <span class="mono">SCREEN</span>
                <Bi ja="画像準備中" en="Image coming soon" />
              </div>
            </div>
            <figcaption>
              <strong><Bi ja={s.title.ja} en={s.title.en} /></strong>
              <Bi ja={s.caption.ja} en={s.caption.en} />
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="devlog">
    <span class="section-number mono">03</span>
    <div class="wrap">
      <p class="eyebrow"><Bi ja="開発ログ" en="Dev Log" /></p>
      <h2 data-reveal>
        <Bi ja="KoeCare の開発状況" en="KoeCare development status" />
      </h2>
      <p class="body-text product-lead" data-reveal>
        <Bi
          ja="クローズドテストから Google Play 公開までの履歴です。KoeCare のこれまでの歩みをまとめています。"
          en="A timeline from closed testing to the Google Play release — KoeCare’s progress so far."
        />
      </p>

      <ul class="devlog-list" data-reveal="stagger">
        {devLog.map((entry) => (
          <li class="devlog-item">
            <span class="devlog-date mono">{entry.date}</span>
            <p class="devlog-title"><Bi ja={entry.title.ja} en={entry.title.en} /></p>
            <p class="devlog-body"><Bi ja={entry.body.ja} en={entry.body.en} /></p>
            {entry.storeLink && koecareReleaseStatus.storeUrl && (
              <a class="devlog-link" href={koecareReleaseStatus.storeUrl} target="_blank" rel="noopener noreferrer">
                <Bi ja="Google Play のアプリページを見る" en="Open the Google Play listing" />
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Footer slot="footer" />

  <style>
    .hero {
      padding-top: clamp(56px, 9vw, 96px);
      padding-bottom: clamp(24px, 4vw, 40px);
    }
    .hero-copy h1 {
      font-size: clamp(1.9rem, 4vw, 2.7rem);
      margin: 18px 0 20px;
    }
    .hero-copy .accent-word {
      font-size: 1.08em;
    }
    .lead {
      color: var(--ink-soft);
      font-size: 1.02rem;
      max-width: 46ch;
    }
    .lead strong {
      color: var(--ink);
    }
    .hero-cta {
      margin-top: 24px;
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .body-text {
      color: var(--ink-soft);
      max-width: 52ch;
    }
    #overview > .wrap,
    #screens > .wrap,
    #devlog > .wrap {
      position: relative;
      z-index: 1;
    }
    #overview h2,
    #screens h2,
    #devlog h2 {
      font-size: clamp(1.4rem, 2.6vw, 1.9rem);
      margin: 10px 0 16px;
    }
    .overview-store {
      margin-top: 24px;
    }
    .product-lead {
      margin-bottom: 36px;
    }
    .devlog-link {
      display: inline-block;
      margin-top: 12px;
      color: var(--accent);
      font-size: 0.88rem;
    }

    .draft-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(20px, 4vw, 32px);
    }
    .draft-card {
      margin: 0;
    }
    .draft-frame {
      position: relative;
      aspect-ratio: 9 / 16;
      max-height: 420px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--paper-raised);
      overflow: hidden;
      display: grid;
      place-items: center;
    }
    .draft-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .draft-placeholder {
      display: grid;
      place-items: center;
      gap: 8px;
      color: var(--ink-soft);
      font-size: 0.9rem;
      text-align: center;
      padding: 24px;
    }
    .draft-placeholder .mono {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: var(--status);
    }
    .draft-card figcaption {
      margin-top: 14px;
      display: grid;
      gap: 4px;
      color: var(--ink-soft);
      font-size: 0.9rem;
    }
    .draft-card figcaption strong {
      color: var(--ink);
      font-family: var(--font-display);
      font-weight: 600;
    }

    @media (max-width: 760px) {
      .draft-grid {
        grid-template-columns: 1fr;
      }
      .draft-frame {
        max-height: 360px;
        max-width: 240px;
        margin-inline: auto;
      }
    }
  </style>

  <script>
    function showShotPlaceholder(img) {
      img.style.display = 'none';
      const ph = img.parentElement?.querySelector('[data-shot-placeholder]');
      if (ph) ph.hidden = false;
    }

    document.querySelectorAll('[data-shot-img]').forEach((img) => {
      img.addEventListener('error', () => showShotPlaceholder(img));
      if (img.complete && img.naturalWidth === 0) showShotPlaceholder(img);
    });
  </script>
</Layout>
