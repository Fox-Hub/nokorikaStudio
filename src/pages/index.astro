---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Bi from '../components/Bi.astro';
import { apps } from '../data/apps.js';

const facts = [
  { ja: '事業者名', en: 'Business name', ja_v: 'Nokorika Studio', en_v: 'Nokorika Studio' },
  { ja: '代表者', en: 'Representative', ja_v: '和田　健太郎', en_v: 'Kentaro Wada' },
  { ja: '所在地', en: 'Location', ja_v: '東京都渋谷区神宮前5丁目51番8号ラ・ポルト青山 2F-7', en_v: 'Tokyo Shibuya-ku 5-51-8 Jingumae La Porte Aoyama 2F-7' },
  {
    ja: '事業内容', en: 'Business',
    ja_v: 'スマートフォン向けアプリケーションの企画・開発',
    en_v: 'Planning and development of smartphone applications',
  },
];
---
<Layout
  title="Nokorika Studio | スマートフォンアプリ開発"
  titleEn="Nokorika Studio | Smartphone App Development"
  description="Nokorika Studio はスマートフォン向けアプリの企画・開発を行う事業者です。カレンダーアプリ Nokorika、騒音計測アプリ KoeCare などを手がけています。"
  descriptionEn="Nokorika Studio plans and develops smartphone apps, including the calendar app Nokorika and the noise meter KoeCare."
>
  <Header slot="header" />

  <!-- ===================== Hero ===================== -->
  <section class="hero">
    <div class="wrap hero-copy" data-reveal>
      <span class="date-stamp mono">NOKORIKA STUDIO</span>
      <h1 class="brand-hero">Nokorika Studio</h1>
      <p class="lead">
        <span class="i18n" data-lang="ja">
          スマートフォン向けアプリの企画・開発を行っています。日々の生活に寄り添う小さなツールを、こつこつ作っています。
        </span>
        <span class="i18n" data-lang="en">
          We plan and build smartphone apps — small, everyday tools made carefully, one update at a time.
        </span>
      </p>
      <div class="hero-cta">
        <a class="cta-link" href="#apps">
          <Bi ja="アプリを見る" en="See our apps" />
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== Apps ===================== -->
  <section id="apps">
    <span class="section-number mono">01</span>
    <div class="wrap">
      <p class="eyebrow"><Bi ja="アプリ" en="Apps" /></p>
      <h2 data-reveal>
        <Bi ja="つくっているアプリ" en="What we’re building" />
      </h2>
      <p class="body-text apps-lead" data-reveal>
        <Bi
          ja="公開中のプロダクトと、いま開発中のものを紹介します。"
          en="Our live products and the ones still in development."
        />
      </p>

      <ul class="app-list" data-reveal="stagger">
        {apps.map((app) => (
          <li>
            <a class="app-row" href={app.href}>
              <div class="app-meta">
                <span class="app-category mono">
                  <Bi ja={app.category.ja} en={app.category.en} />
                </span>
                <h3>
                  {app.name}
                  {app.nameJa !== app.name && (
                    <span class="app-name-ja i18n" data-lang="ja">（{app.nameJa}）</span>
                  )}
                </h3>
                <p><Bi ja={app.summary.ja} en={app.summary.en} /></p>
              </div>
              <div class="app-side">
                <span class="tag">
                  <Bi ja={app.status.ja} en={app.status.en} />
                </span>
                <span class="app-arrow mono" aria-hidden="true">→</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== About ===================== -->
  <section id="about">
    <span class="section-number mono">02</span>
    <div class="wrap about-grid">
      <div data-reveal>
        <p class="eyebrow"><Bi ja="事業概要" en="About Us" /></p>
        <h2><Bi ja="毎日使うアプリを、一人で作る。" en="Building everyday apps, solo." /></h2>
        <p class="body-text">
          <Bi
            ja="私たちは、スマートフォン向けアプリケーションの企画・開発を行う事業者です。カレンダーアプリ Nokorika を Google Play で公開し、新たに騒音計測アプリ KoeCare の開発も進めています。"
            en="We’re a studio that plans and develops smartphone apps. Nokorika, our calendar app, is live on Google Play, and we’re also building KoeCare, a noise meter."
          />
        </p>
        <p class="signature">
          <Bi ja="— Nokorika Studio" en="— Kentaro Wada" />
        </p>
      </div>
      <dl class="fact-list" data-reveal>
        {facts.map((f) => (
          <div class="fact-row">
            <dt class="mono"><Bi ja={f.ja} en={f.en} /></dt>
            <dd><Bi ja={f.ja_v} en={f.en_v} /></dd>
          </div>
        ))}
        <div class="fact-row">
          <dt class="mono"><Bi ja="連絡先" en="Contact" /></dt>
          <dd>
            <a href="/contact">
              <Bi ja="お問い合わせページへ" en="Go to contact page" />
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <Footer slot="footer" />

  <style>
    .hero {
      padding-top: clamp(56px, 9vw, 96px);
      padding-bottom: clamp(24px, 4vw, 48px);
    }
    .brand-hero {
      font-size: clamp(2.4rem, 6vw, 3.6rem);
      margin: 18px 0 20px;
      letter-spacing: -0.02em;
    }
    .lead {
      color: var(--ink-soft);
      font-size: 1.02rem;
      max-width: 42ch;
    }
    .hero-cta {
      margin-top: 28px;
    }
    .cta-link {
      display: inline-flex;
      align-items: center;
      padding: 10px 18px;
      border-radius: 999px;
      background: var(--accent);
      color: var(--accent-ink);
      text-decoration: none;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 0.92rem;
    }
    .cta-link:hover {
      filter: brightness(1.08);
    }

    #apps > .wrap {
      position: relative;
      z-index: 1;
    }
    #apps h2 {
      font-size: clamp(1.4rem, 2.6vw, 1.9rem);
      margin: 10px 0 16px;
    }
    .apps-lead {
      margin-bottom: 36px;
    }
    .body-text {
      color: var(--ink-soft);
      max-width: 52ch;
    }

    .app-list {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--line);
    }
    .app-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      padding: 28px 0;
      border-bottom: 1px solid var(--line);
      text-decoration: none;
      color: inherit;
      transition: background-color 0.15s ease;
    }
    .app-row:hover {
      background: color-mix(in srgb, var(--paper-raised) 70%, transparent);
    }
    .app-category {
      display: block;
      font-size: 0.72rem;
      color: var(--ink-soft);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .app-meta h3 {
      font-size: 1.25rem;
      margin: 0 0 10px;
    }
    .app-name-ja {
      font-weight: 500;
      font-size: 0.9em;
      color: var(--ink-soft);
    }
    .app-meta p {
      margin: 0;
      color: var(--ink-soft);
      max-width: 48ch;
      font-size: 0.95rem;
    }
    .app-side {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-shrink: 0;
      padding-top: 4px;
    }
    .app-arrow {
      color: var(--accent);
      font-size: 1.1rem;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: clamp(32px, 6vw, 64px);
      position: relative;
      z-index: 1;
    }
    .about-grid h2 {
      font-size: clamp(1.4rem, 2.6vw, 1.9rem);
      margin: 10px 0 16px;
      max-width: 22ch;
    }
    .signature {
      margin-top: 18px;
    }
    .fact-list {
      margin: 0;
      border-top: 1px solid var(--line);
    }
    .fact-row {
      display: grid;
      grid-template-columns: 96px 1fr;
      gap: 16px;
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
    }
    .fact-row dt {
      color: var(--ink-soft);
      font-size: 0.8rem;
    }
    .fact-row dd {
      margin: 0;
    }
    .fact-row a {
      color: var(--accent);
      text-decoration: underline;
    }

    @media (max-width: 760px) {
      .about-grid {
        grid-template-columns: 1fr;
      }
      .app-row {
        flex-direction: column;
        gap: 16px;
      }
      .app-side {
        width: 100%;
        justify-content: space-between;
      }
    }
  </style>
</Layout>
